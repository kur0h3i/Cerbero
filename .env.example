# Configuración de Cerbero. Copia este fichero a `.env` (junto a docker-compose.yml)
# y rellena al menos TELEGRAM_TOKEN y TELEGRAM_CHAT_ID. El resto es opcional:
# vacío = valor por defecto (el indicado en cada comentario).

# --- Telegram ------------------------------------------------------------------
# Token del bot (de @BotFather) y chat al que enviar las alertas. Sin ellos,
# las alertas solo quedan en el registro y en la API.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Nombre del servidor en los mensajes (server-kuro) y zona horaria de las fechas
# (Europe/Madrid).
SERVER_NAME=
TZ=

# Minutos antes de reenviar una alerta con la misma clave (30).
ALERT_COOLDOWN_MIN=
# Aviso 🟢 al arrancar Cerbero, útil para enterarse de un reinicio (true).
NOTIFY_STARTUP=


# --- Cabeza 1: recursos --------------------------------------------------------
# Segundos entre lecturas de recursos y contenedores (30).
POLL_INTERVAL_S=
# % de CPU a partir del cual una lectura es alta (85) y lecturas altas seguidas
# necesarias para alertar (3).
CPU_THRESHOLD=
CPU_SUSTAINED=
# GB de RAM disponible por debajo de los cuales se alerta (1.5).
RAM_FREE_MIN_GB=
# % de uso de disco a partir del cual se alerta (85) y puntos de montaje
# vigilados, separados por comas (/,/srv/archivos,/srv/extra).
DISK_THRESHOLD=
DISKS=

# --- Cabeza 2: contenedores ----------------------------------------------------
# Más de RESTART_LOOP_THRESHOLD reinicios (5) en RESTART_LOOP_WINDOW_MIN minutos
# (10) cuentan como bucle de reinicios.
RESTART_LOOP_THRESHOLD=
RESTART_LOOP_WINDOW_MIN=
# Contenedores que no generan alertas, separados por comas (ninguno).
CONTAINERS_IGNORE=

# Nivel del registro: DEBUG, INFO, WARNING... (INFO).
LOG_LEVEL=
